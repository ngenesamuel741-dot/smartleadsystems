rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only this email can change content, read leads and see private settings.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['smartleadads.business@gmail.com'];
    }

    // Website content: anyone can read, only the admin can write.
    match /{col}/{id} {
      allow read: if col in ['settings', 'services', 'projects', 'posts', 'pricing', 'testimonials', 'clients', 'founders', 'faqs', 'process', 'industries', 'formfields', 'pages'];
      allow write: if isAdmin() && col in ['settings', 'services', 'projects', 'posts', 'pricing', 'testimonials', 'clients', 'founders', 'faqs', 'process', 'industries', 'formfields', 'pages'];
    }

    // Private admin settings (for example the Netlify build hook). Nobody else can read these.
    match /private/{id} {
      allow read, write: if isAdmin();
    }

    // Contact-form enquiries: anyone can send one (validated), only the admin can read or manage them.
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'company', 'service', 'plan', 'message', 'answers', 'qualified', 'qualReason', 'source', 'landing', 'attribution', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200 && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.message is string && request.resource.data.message.size() <= 4000
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 60
        && request.resource.data.company is string && request.resource.data.company.size() <= 120
        && request.resource.data['service'] is string && request.resource.data['service'].size() <= 120
        && request.resource.data.plan is string && request.resource.data.plan.size() <= 120
        && request.resource.data.source is string && request.resource.data.source.size() <= 200
        && request.resource.data.landing is string && request.resource.data.landing.size() <= 200
        && request.resource.data.qualReason is string && request.resource.data.qualReason.size() <= 400
        && request.resource.data.answers is map && request.resource.data.answers.size() <= 30
        && request.resource.data.attribution is map && request.resource.data.attribution.size() <= 15
        && request.resource.data.qualified is bool
        && ((request.resource.data.qualified == true && request.resource.data.status == 'new')
            || (request.resource.data.qualified == false && request.resource.data.status == 'unqualified'))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
